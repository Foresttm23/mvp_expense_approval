DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_db
APP_ENV=development

# JWT — generate a strong random string for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Advisory (Phase 5)
# Obtain a Gemini API key at https://aistudio.google.com/apikey
# Leave unset to disable AI features and serve graceful fallback responses.
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash-lite
AI_TIMEOUT_SECONDS=5.0
